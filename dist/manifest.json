{
  "manifest_version": 3,
  "name": "Portal",
  "version": "1.0.0",
  "description": "Intelligent, beautiful, ultra-lightweight Chrome homepage and browser launcher",
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "storage",
    "topSites",
    "favicon",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "omnibox": {
    "keyword": "p"
  },
  "commands": {
    "toggle-launcher": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K",
        "windows": "Alt+K"
      },
      "description": "Toggle Portal floating command palette"
    }
  },
  "action": {
    "default_title": "Portal Launcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
